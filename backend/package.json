    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.16",
    "socket.io": "^4.8.4",
    "twilio": "^6.1.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^6.4.1"
