# Authentication Configuration
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# AI Service URL
AI_SERVICE_URL=http://localhost:8000

# Prisma CLI Configuration
PRISMA_GENERATE_SKIP_AUTOINSTALL=true

# Twilio WhatsApp Configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
