# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration
CLIENT_URL=http://localhost:5173

# Database Connection (Supabase / PostgreSQL)
DATABASE_URL=
# Direct connection for Prisma migrations (same URL for local PostgreSQL)
DIRECT_URL=

# Authentication Configuration
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# AI Service URL
AI_SERVICE_URL=http://localhost:8000

# Prisma CLI Configuration
PRISMA_GENERATE_SKIP_AUTOINSTALL=true

# Twilio WhatsApp Configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Optional local Python executable and trained donation model artifact
DONATION_PYTHON=python
# DONATION_MODEL_PATH=/absolute/path/donation-model.json

# Company Connect email links: use a publicly reachable HTTPS backend URL for real inboxes.
API_PUBLIC_URL=http://localhost:5000/api
# Gmail app password or SMTP settings (do not commit real credentials).
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Optional real placement Admin inbox for acceptance notices and availability replies.
PLACEMENT_ADMIN_EMAIL=
